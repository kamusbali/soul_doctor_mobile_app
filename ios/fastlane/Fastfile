default_platform(:ios)

PROJECT_ROOT = File.expand_path("../..", __dir__)

platform :ios do
  ############################################################
  # HELPERS
  ############################################################

  def require_environment_variable(name)
    value = ENV[name]

    if value.nil? || value.empty?
      UI.user_error!("#{name} is not configured")
    end

    value
  end

  def build_number
    require_environment_variable("BUILD_NUMBER")
  end

  def ios_bundle_identifier
    require_environment_variable(
      "IOS_BUNDLE_IDENTIFIER"
    )
  end

  def apple_developer_team_id
    require_environment_variable(
      "APPLE_DEVELOPER_TEAM_ID"
    )
  end

  def dotenv_path
    File.join(PROJECT_ROOT, ".env")
  end

  def validate_dotenv
    path = dotenv_path

    unless File.exist?(path)
      UI.user_error!(
        ".env was not found at #{path}. " \
        "Generate it in GitHub Actions before running Fastlane."
      )
    end

    if File.zero?(path)
      UI.user_error!(".env is empty: #{path}")
    end

    content = File.read(path)

    unless content.match?(/^ENV_NAME=.+$/)
      UI.user_error!("ENV_NAME is missing from .env")
    end

    unless content.match?(/^BASE_URL=.+$/)
      UI.user_error!("BASE_URL is missing from .env")
    end

    UI.success!(".env successfully validated")
  end

  def run_flutter(command)
    Dir.chdir(PROJECT_ROOT) do
      sh("fvm flutter #{command}")
    end
  end

  def app_store_api_key
    key_id = require_environment_variable(
      "APP_STORE_CONNECT_API_KEY_ID"
    )

    issuer_id = require_environment_variable(
      "APP_STORE_CONNECT_ISSUER_ID"
    )

    key_content = require_environment_variable(
      "APP_STORE_CONNECT_API_KEY_CONTENT"
    )

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,

      # GitHub Secret berisi hasil Base64 file .p8.
      is_key_content_base64: true,

      duration: 1_200,
      in_house: false
    )
  end

  def setup_signing(api_key)
    match(
      type: "appstore",
      readonly: is_ci,
      api_key: api_key,

      app_identifier: ios_bundle_identifier,
      team_id: apple_developer_team_id,

      git_url: require_environment_variable(
        "MATCH_GIT_URL"
      ),

      git_basic_authorization: ENV[
        "MATCH_GIT_BASIC_AUTHORIZATION"
      ]
    )
  end

  def build_signed_ios(api_key)
    validate_dotenv
    setup_signing(api_key)

    UI.header("Building signed iOS application")
    UI.message("Bundle ID: #{ios_bundle_identifier}")
    UI.message("Build number: #{build_number}")

    run_flutter("clean")
    run_flutter("pub get")

    run_flutter(
      "build ipa " \
      "--release " \
      "--build-number=#{build_number}"
    )
  end

  def build_unsigned_ios
    validate_dotenv

    UI.header("Building unsigned iOS application")
    UI.message("Bundle ID: #{ios_bundle_identifier}")
    UI.message("Build number: #{build_number}")

    run_flutter("clean")
    run_flutter("pub get")

    run_flutter(
      "build ios " \
      "--release " \
      "--no-codesign " \
      "--build-number=#{build_number}"
    )
  end

  def ipa_path
    ipa_files = Dir[
      File.join(
        PROJECT_ROOT,
        "build",
        "ios",
        "ipa",
        "*.ipa"
      )
    ]

    if ipa_files.empty?
      UI.user_error!(
        "IPA file was not found in build/ios/ipa"
      )
    end

    ipa_files.first
  end

  ############################################################
  # DEVELOPMENT
  ############################################################

  desc "Build unsigned iOS application for development validation"
  lane :development do
    build_unsigned_ios
  end

  ############################################################
  # STAGING
  ############################################################

  desc "Build signed iOS staging application"
  lane :staging do
    api_key = app_store_api_key

    build_signed_ios(api_key)
  end

  desc "Build and upload iOS staging application to TestFlight"
  lane :deploy_staging do
    api_key = app_store_api_key

    build_signed_ios(api_key)

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,

      skip_waiting_for_build_processing: true
    )
  end

  ############################################################
  # RELEASE CANDIDATE
  ############################################################

  desc "Build signed iOS production candidate without upload"
  lane :release do
    api_key = app_store_api_key

    build_signed_ios(api_key)
  end

  ############################################################
  # PRODUCTION
  ############################################################

  desc "Build and upload iOS production application"
  lane :production do
    api_key = app_store_api_key

    build_signed_ios(api_key)

    upload_to_app_store(
      api_key: api_key,
      ipa: ipa_path,

      # Upload binary ke App Store Connect,
      # tetapi belum mengirimkannya ke App Review.
      submit_for_review: false,

      # Setelah disetujui Apple, aplikasi tidak langsung dirilis.
      automatic_release: false,

      skip_metadata: true,
      skip_screenshots: true,

      force: true
    )
  end
end