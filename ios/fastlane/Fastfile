opt_out_usage

default_platform(:ios)

PROJECT_ROOT = File.expand_path("../..", __dir__)

platform :ios do
  ############################################################
  # HELPERS
  ############################################################

  def require_environment_variable(name)
    value = ENV[name]

    if value.nil? || value.strip.empty?
      UI.user_error!("#{name} is not configured")
    end

    value.strip
  end

  def build_number
    number = require_environment_variable("BUILD_NUMBER")

    unless number.match?(/^\d+$/)
      UI.user_error!(
        "BUILD_NUMBER must contain numbers only. Received: #{number}"
      )
    end

    number
  end

  def ios_bundle_identifier
    require_environment_variable(
      "IOS_BUNDLE_IDENTIFIER"
    )
  end

  def apple_developer_team_id
    require_environment_variable(
      "APPLE_DEVELOPER_TEAM_ID"
    )
  end

  def dotenv_path
    File.join(PROJECT_ROOT, ".env")
  end

  def parse_dotenv
    path = dotenv_path

    unless File.exist?(path)
      UI.user_error!(
        ".env was not found at #{path}. " \
        "Generate it in GitHub Actions before running Fastlane."
      )
    end

    if File.zero?(path)
      UI.user_error!(".env is empty: #{path}")
    end

    values = {}

    File.readlines(path, chomp: true).each do |line|
      stripped_line = line.strip

      next if stripped_line.empty?
      next if stripped_line.start_with?("#")
      next unless stripped_line.include?("=")

      key, value = stripped_line.split("=", 2)

      values[key.strip] = value.to_s.strip
    end

    values
  end

  def validate_dotenv
    values = parse_dotenv

    env_name = values["ENV_NAME"]
    base_url = values["BASE_URL"]

    if env_name.nil? || env_name.empty?
      UI.user_error!("ENV_NAME is missing or empty in .env")
    end

    if base_url.nil? || base_url.empty?
      UI.user_error!("BASE_URL is missing or empty in .env")
    end

    unless base_url.match?(%r{\Ahttps?://.+})
      UI.user_error!(
        "BASE_URL must start with http:// or https://"
      )
    end

    UI.success(".env successfully validated")
    UI.message("Environment: #{env_name}")
  end

  def run_flutter(command)
    Dir.chdir(PROJECT_ROOT) do
      sh("fvm flutter #{command}")
    end
  end

  ############################################################
  # APP STORE CONNECT
  ############################################################

  def app_store_api_key
    key_id = require_environment_variable(
      "APP_STORE_CONNECT_API_KEY_ID"
    )

    issuer_id = require_environment_variable(
      "APP_STORE_CONNECT_ISSUER_ID"
    )

    key_content = require_environment_variable(
      "APP_STORE_CONNECT_API_KEY_CONTENT"
    )

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,

      # Secret berisi Base64 dari file AuthKey_*.p8.
      is_key_content_base64: true,

      duration: 1_200,
      in_house: false
    )
  end

  ############################################################
  # CODE SIGNING
  ############################################################

  def setup_signing(api_key)
    match_options = {
      type: "appstore",
      readonly: is_ci,
      api_key: api_key,

      app_identifier: ios_bundle_identifier,
      team_id: apple_developer_team_id,

      git_url: require_environment_variable(
        "MATCH_GIT_URL"
      )
    }

    git_authorization = ENV[
      "MATCH_GIT_BASIC_AUTHORIZATION"
    ]

    if git_authorization &&
       !git_authorization.strip.empty?

      match_options[:git_basic_authorization] =
        git_authorization
    end

    match(**match_options)
  end

  ############################################################
  # BUILD
  ############################################################

  def build_signed_ios(api_key)
    validate_dotenv
    setup_signing(api_key)

    UI.header("Building Signed iOS Application")
    UI.message("Bundle ID: #{ios_bundle_identifier}")
    UI.message("Build number: #{build_number}")

    run_flutter("clean")
    run_flutter("pub get")

    run_flutter(
      "build ipa " \
      "--release " \
      "--build-number=#{build_number}"
    )
  end

  def build_unsigned_ios
    validate_dotenv

    UI.header("Building Unsigned iOS Application")
    UI.message("Bundle ID: #{ios_bundle_identifier}")
    UI.message("Build number: #{build_number}")

    run_flutter("clean")
    run_flutter("pub get")

    run_flutter(
      "build ios " \
      "--release " \
      "--no-codesign " \
      "--build-number=#{build_number}"
    )
  end

  def ipa_path
    ipa_files = Dir[
      File.join(
        PROJECT_ROOT,
        "build",
        "ios",
        "ipa",
        "*.ipa"
      )
    ]

    if ipa_files.empty?
      UI.user_error!(
        "IPA file was not found in build/ios/ipa"
      )
    end

    ipa_files.first
  end

  ############################################################
  # DEVELOPMENT
  ############################################################

  desc "Build unsigned iOS application for development"
  lane :development do
    build_unsigned_ios
  end

  ############################################################
  # STAGING
  ############################################################

  desc "Build signed iOS staging application"
  lane :staging do
    api_key = app_store_api_key

    build_signed_ios(api_key)
  end

  desc "Build and upload iOS staging application to TestFlight"
  lane :deploy_staging do
    api_key = app_store_api_key

    build_signed_ios(api_key)

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,

      skip_waiting_for_build_processing: true
    )
  end

  ############################################################
  # RELEASE CANDIDATE
  ############################################################

  desc "Build signed iOS production candidate without upload"
  lane :release do
    api_key = app_store_api_key

    build_signed_ios(api_key)
  end

  ############################################################
  # PRODUCTION
  ############################################################

  desc "Build and upload iOS production application"
  lane :production do
    api_key = app_store_api_key

    build_signed_ios(api_key)

    upload_to_app_store(
      api_key: api_key,
      ipa: ipa_path,

      # Tidak otomatis dikirim ke App Review.
      submit_for_review: false,

      # Tidak langsung dirilis setelah disetujui.
      automatic_release: false,

      skip_metadata: true,
      skip_screenshots: true,

      force: true
    )
  end
end