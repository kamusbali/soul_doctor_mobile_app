match_git_url = ENV.fetch("MATCH_GIT_URL")
  .strip
  .sub(%r{/+\z}, "")

match_git_url =
  "#{match_git_url}.git" unless match_git_url.end_with?(".git")

git_url(match_git_url)

storage_mode("git")
git_branch("master")

type("appstore")

app_identifier([
  ENV.fetch("IOS_BUNDLE_IDENTIFIER").strip
])

team_id(
  ENV.fetch("APPLE_DEVELOPER_TEAM_ID").strip
)