default_platform(:android)

PROJECT_ROOT = File.expand_path("../..", __dir__)

platform :android do
  ############################################################
  # HELPERS
  ############################################################

  def require_environment_variable(name)
    value = ENV[name]

    if value.nil? || value.empty?
      UI.user_error!("#{name} is not configured")
    end

    value
  end

  def build_number
    require_environment_variable("BUILD_NUMBER")
  end

  def android_package_name
    ENV.fetch(
      "ANDROID_PACKAGE_NAME",
      "dev.putuwaw.soul_doctor"
    )
  end

  def dotenv_path
    File.join(PROJECT_ROOT, ".env")
  end

  def validate_dotenv
    path = dotenv_path

    unless File.exist?(path)
      UI.user_error!(
        ".env was not found at #{path}. " \
        "Generate it in GitHub Actions before running Fastlane."
      )
    end

    if File.zero?(path)
      UI.user_error!(".env is empty: #{path}")
    end

    content = File.read(path)

    unless content.match?(/^ENV_NAME=.+$/)
      UI.user_error!("ENV_NAME is missing from .env")
    end

    unless content.match?(/^BASE_URL=.+$/)
      UI.user_error!("BASE_URL is missing from .env")
    end

    UI.success!(".env successfully validated")
  end

  def run_flutter(command)
    Dir.chdir(PROJECT_ROOT) do
      sh("fvm flutter #{command}")
    end
  end

  def build_android
    validate_dotenv

    UI.header("Building Android")
    UI.message("Package: #{android_package_name}")
    UI.message("Build number: #{build_number}")

    run_flutter("clean")
    run_flutter("pub get")

    run_flutter(
      "build appbundle " \
      "--release " \
      "--build-number=#{build_number}"
    )
  end

  def android_aab_path
    path = File.join(
      PROJECT_ROOT,
      "build",
      "app",
      "outputs",
      "bundle",
      "release",
      "app-release.aab"
    )

    unless File.exist?(path)
      UI.user_error!("Android App Bundle was not found: #{path}")
    end

    path
  end

  def google_play_json_key
    path = require_environment_variable(
      "GOOGLE_PLAY_JSON_KEY_PATH"
    )

    unless File.exist?(path)
      UI.user_error!(
        "Google Play JSON key was not found: #{path}"
      )
    end

    path
  end

  ############################################################
  # DEVELOPMENT
  ############################################################

  desc "Build Android development artifact"
  lane :development do
    build_android
  end

  ############################################################
  # STAGING
  ############################################################

  desc "Build Android staging artifact"
  lane :staging do
    build_android
  end

  desc "Build and upload Android to Google Play Internal Testing"
  lane :deploy_staging do
    build_android

    upload_to_play_store(
      package_name: android_package_name,
      json_key: google_play_json_key,
      aab: android_aab_path,

      track: "internal",
      release_status: "completed",

      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  ############################################################
  # RELEASE CANDIDATE
  ############################################################

  desc "Build Android production candidate without store upload"
  lane :release do
    build_android
  end

  ############################################################
  # PRODUCTION
  ############################################################

  desc "Build and upload Android to Google Play Production"
  lane :production do
    build_android

    upload_to_play_store(
      package_name: android_package_name,
      json_key: google_play_json_key,
      aab: android_aab_path,

      track: "production",

      # Upload ke production sebagai draft.
      # Publikasi final dilakukan melalui Play Console.
      release_status: "draft",

      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end