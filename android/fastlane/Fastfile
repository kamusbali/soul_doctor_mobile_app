opt_out_usage

default_platform(:android)

PROJECT_ROOT = File.expand_path("../..", __dir__)

platform :android do
  ############################################################
  # HELPERS
  ############################################################

  def require_environment_variable(name)
    value = ENV[name]&.strip

    if value.nil? || value.empty?
      UI.user_error!("#{name} is not configured")
    end

    value
  end

  def build_number
    number = require_environment_variable("BUILD_NUMBER")

    unless number.match?(/\A\d+\z/)
      UI.user_error!(
        "BUILD_NUMBER must contain numbers only. Received: #{number}"
      )
    end

    number
  end

  def android_package_name
    package_name = ENV.fetch(
      "ANDROID_PACKAGE_NAME",
      "dev.putuwaw.soul_doctor"
    ).strip

    if package_name.empty?
      UI.user_error!("ANDROID_PACKAGE_NAME is empty")
    end

    package_name
  end

  ############################################################
  # DOTENV
  ############################################################

  def dotenv_path(environment_file)
    File.join(
      PROJECT_ROOT,
      "conf",
      environment_file
    )
  end

  def parse_dotenv(environment_file)
    path = dotenv_path(environment_file)

    unless File.exist?(path)
      UI.user_error!(
        "Environment file was not found at #{path}. " \
        "Generate conf/#{environment_file} in GitHub Actions " \
        "before running Fastlane."
      )
    end

    if File.zero?(path)
      UI.user_error!(
        "Environment file is empty: #{path}"
      )
    end

    values = {}

    File.readlines(path, chomp: true).each do |line|
      stripped_line = line.strip

      next if stripped_line.empty?
      next if stripped_line.start_with?("#")
      next unless stripped_line.include?("=")

      key, value = stripped_line.split("=", 2)

      values[key.strip] = value.to_s.strip
    end

    values
  end

  def validate_dotenv(environment_file)
    path = dotenv_path(environment_file)
    values = parse_dotenv(environment_file)

    env_name = values["ENV_NAME"]
    base_url = values["BASE_URL"]

    if env_name.nil? || env_name.empty?
      UI.user_error!(
        "ENV_NAME is missing or empty in #{path}"
      )
    end

    if base_url.nil? || base_url.empty?
      UI.user_error!(
        "BASE_URL is missing or empty in #{path}"
      )
    end

    unless base_url.match?(%r{\Ahttps?://.+})
      UI.user_error!(
        "BASE_URL in #{path} must start with http:// or https://"
      )
    end

    unresolved_placeholder = values.any? do |_key, value|
      value.match?(/\$\{.+\}/)
    end

    if unresolved_placeholder
      UI.user_error!(
        "Environment file contains unresolved placeholders: #{path}"
      )
    end

    UI.success(
      "Environment file successfully validated: #{path}"
    )
  end

  ############################################################
  # FLUTTER HELPERS
  ############################################################

  def run_flutter(command)
    Dir.chdir(PROJECT_ROOT) do
      sh("fvm flutter #{command}")
    end
  end

  def flutter_target(flavor)
    relative_target = "lib/main_#{flavor}.dart"

    absolute_target = File.join(
      PROJECT_ROOT,
      relative_target
    )

    unless File.exist?(absolute_target)
      UI.user_error!(
        "Flutter target was not found: #{relative_target}"
      )
    end

    relative_target
  end

  def build_android(
    flavor:,
    environment_file:
  )
    validate_dotenv(environment_file)

    target = flutter_target(flavor)
    number = build_number

    UI.header("Building Android Application")
    UI.message("Flavor: #{flavor}")
    UI.message("Target: #{target}")
    UI.message("Environment file: conf/#{environment_file}")
    UI.message("Package name: #{android_package_name}")
    UI.message("Build number: #{number}")

    run_flutter("clean")
    run_flutter("pub get")

    run_flutter(
      "build appbundle " \
      "--release " \
      "--flavor #{flavor} " \
      "--target #{target} " \
      "--build-number=#{number}"
    )

    UI.success(
      "Android #{flavor} application built successfully"
    )
  end

  ############################################################
  # ANDROID ARTIFACT
  ############################################################

  def android_aab_path(flavor)
    possible_paths = [
      File.join(
        PROJECT_ROOT,
        "build",
        "app",
        "outputs",
        "bundle",
        "#{flavor}Release",
        "app-#{flavor}-release.aab"
      ),
      File.join(
        PROJECT_ROOT,
        "build",
        "app",
        "outputs",
        "bundle",
        "#{flavor}Release",
        "app-release.aab"
      )
    ]

    path = possible_paths.find do |candidate|
      File.exist?(candidate)
    end

    if path.nil?
      UI.user_error!(
        "Android App Bundle was not found.\n" \
        "Checked paths:\n#{possible_paths.join("\n")}"
      )
    end

    UI.message("Android App Bundle: #{path}")

    path
  end

  ############################################################
  # GOOGLE PLAY
  ############################################################

  def google_play_json_key
    path = require_environment_variable(
      "GOOGLE_PLAY_JSON_KEY_PATH"
    )

    unless File.exist?(path)
      UI.user_error!(
        "Google Play JSON key was not found: #{path}"
      )
    end

    path
  end

  ############################################################
  # DEVELOPMENT
  ############################################################

  desc "Build Android development artifact"
  lane :development do
    build_android(
      flavor: "development",
      environment_file: "development.env"
    )
  end

  ############################################################
  # STAGING
  ############################################################

  desc "Build Android staging artifact"
  lane :staging do
    build_android(
      flavor: "staging",
      environment_file: "staging.env"
    )
  end

  desc "Build and upload Android to Google Play Internal Testing"
  lane :deploy_staging do
    flavor = "staging"

    build_android(
      flavor: flavor,
      environment_file: "staging.env"
    )

    # upload_to_play_store(
    #   package_name: android_package_name,
    #   json_key: google_play_json_key,
    #   aab: android_aab_path(flavor),
    #
    #   track: "internal",
    #   release_status: "completed",
    #
    #   skip_upload_metadata: true,
    #   skip_upload_images: true,
    #   skip_upload_screenshots: true
    # )
  end

  ############################################################
  # RELEASE CANDIDATE
  ############################################################

  desc "Build Android production candidate without store upload"
  lane :release do
    build_android(
      flavor: "production",
      environment_file: "production.env"
    )
  end

  ############################################################
  # PRODUCTION
  ############################################################

  desc "Build and upload Android to Google Play Production"
  lane :production do
    flavor = "production"

    build_android(
      flavor: flavor,
      environment_file: "production.env"
    )

    # upload_to_play_store(
    #   package_name: android_package_name,
    #   json_key: google_play_json_key,
    #   aab: android_aab_path(flavor),
    #
    #   track: "production",
    #   release_status: "draft",
    #
    #   skip_upload_metadata: true,
    #   skip_upload_images: true,
    #   skip_upload_screenshots: true
    # )
  end
end